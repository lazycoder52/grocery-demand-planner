# --- Python / environments ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Secrets ---
.env
.env.*
.kaggle/
kaggle.json

# --- Data (raw Kaggle files are never committed) ---
data/raw/
data/interim/
data/processed/
*.duckdb
*.duckdb.wal

# Parquet: gitignore large model prediction matrices (>1MB) to prevent repo bloat;
# only small summary/tradeoff aggregates (*_summary.parquet) are tracked.
# Large predictions are regenerated via: python -m demand_planner.pipeline --stages models
*.parquet
!outputs/*_summary.parquet
!outputs/summary_*.parquet

# --- Legacy local code (never published) ---
_legacy_local/

# --- Tooling caches ---
node_modules/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
scratch/
catboost_info/
mlruns/

# --- Editors ---
.vscode/
.idea/

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
